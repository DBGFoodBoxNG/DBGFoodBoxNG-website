# Public site URL used in metadata, sitemap/robots and Paystack callback URLs.
# Set this to the real https:// domain before going live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack — required for live card / transfer / USSD payments.
# Keep the secret key server-side only; it is never exposed to the browser.
PAYSTACK_SECRET_KEY=

# Contact + social links. Replace the defaults in lib/site.ts (or set these).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Development only: when "1", /forgot-password returns the reset link in the
# page because no transactional email provider is connected yet. Never enable
# this in production.
SHOW_RESET_LINK=0

# Social sign-in is not implemented. These are the credentials that would be
# required before the Google / Apple buttons can work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
